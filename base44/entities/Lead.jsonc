{
  "name": "Lead",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "ID do cliente"
    },
    "order_id": {
      "type": "string",
      "description": "ID do pedido ao qual o lead pertence"
    },
    "form_template_id": {
      "type": "string",
      "description": "ID do formul\u00e1rio de origem"
    },
    "product_id": {
      "type": "string",
      "description": "ID do produto relacionado"
    },
    "assigned_to": {
      "type": "string",
      "description": "Email do usu\u00e1rio respons\u00e1vel"
    },
    "lead_type": {
      "type": "string",
      "enum": [
        "juridica",
        "fisica"
      ],
      "description": "Tipo de lead"
    },
    "state": {
      "type": "string",
      "description": "Estado (UF)"
    },
    "ddd": {
      "type": "string",
      "description": "DDD do telefone"
    },
    "is_distributed": {
      "type": "boolean",
      "default": false,
      "description": "Se o lead foi distribu\u00eddo"
    },
    "distribution_date": {
      "type": "string",
      "format": "date",
      "description": "Data de distribui\u00e7\u00e3o do lead"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "qualified",
        "negotiation",
        "won",
        "lost"
      ],
      "default": "new",
      "description": "Status do lead"
    },
    "source": {
      "type": "string",
      "description": "Origem do lead"
    },
    "form_data": {
      "type": "object",
      "description": "Dados din\u00e2micos do formul\u00e1rio em JSON",
      "additionalProperties": true
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es gerais"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium",
      "description": "Prioridade do lead"
    },
    "last_contact_date": {
      "type": "string",
      "format": "date",
      "description": "Data do \u00faltimo contato"
    },
    "next_action_date": {
      "type": "string",
      "format": "date",
      "description": "Data da pr\u00f3xima a\u00e7\u00e3o"
    },
    "next_action": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da pr\u00f3xima a\u00e7\u00e3o"
    }
  },
  "required": [
    "client_id"
  ]
}