{
  "name": "Client",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome da empresa/cliente"
    },
    "document": {
      "type": "string",
      "description": "CNPJ/CPF"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "E-mail de contato"
    },
    "phone": {
      "type": "string",
      "description": "Telefone"
    },
    "address": {
      "type": "string",
      "description": "Endere\u00e7o completo"
    },
    "city": {
      "type": "string",
      "description": "Cidade"
    },
    "state": {
      "type": "string",
      "description": "Estado"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "description": "Status do cliente"
    },
    "logo_url": {
      "type": "string",
      "description": "URL do logo da empresa"
    }
  },
  "required": [
    "name"
  ]
}