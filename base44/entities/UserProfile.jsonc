{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "ID do cliente ao qual o usu\u00e1rio pertence"
    },
    "role": {
      "type": "string",
      "enum": [
        "master",
        "manager",
        "supervisor",
        "producer"
      ],
      "default": "producer",
      "description": "N\u00edvel hier\u00e1rquico do usu\u00e1rio"
    },
    "full_name": {
      "type": "string",
      "description": "Nome completo do usu\u00e1rio"
    },
    "parent_user_id": {
      "type": "string",
      "description": "ID do superior hier\u00e1rquico (para estrutura de downline)"
    },
    "phone": {
      "type": "string",
      "description": "Telefone de contato"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "description": "Status do usu\u00e1rio"
    }
  },
  "required": [
    "client_id",
    "role"
  ]
}