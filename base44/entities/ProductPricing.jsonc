{
  "name": "ProductPricing",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "ID do produto"
    },
    "lead_type": {
      "type": "string",
      "enum": [
        "juridica",
        "fisica"
      ],
      "description": "Tipo de lead"
    },
    "state": {
      "type": "string",
      "description": "Estado (UF)"
    },
    "ddd": {
      "type": "string",
      "description": "DDD espec\u00edfico (opcional)"
    },
    "price": {
      "type": "number",
      "description": "Pre\u00e7o da lead"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Se a precifica\u00e7\u00e3o est\u00e1 ativa"
    }
  },
  "required": [
    "product_id",
    "lead_type",
    "state",
    "price"
  ]
}