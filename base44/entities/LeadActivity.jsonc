{
  "name": "LeadActivity",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string",
      "description": "ID do lead"
    },
    "activity_type": {
      "type": "string",
      "enum": [
        "note",
        "call",
        "email",
        "meeting",
        "status_change",
        "assignment"
      ],
      "default": "note",
      "description": "Tipo de atividade"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da atividade"
    },
    "old_value": {
      "type": "string",
      "description": "Valor anterior (para mudan\u00e7as)"
    },
    "new_value": {
      "type": "string",
      "description": "Novo valor (para mudan\u00e7as)"
    }
  },
  "required": [
    "lead_id",
    "activity_type"
  ]
}