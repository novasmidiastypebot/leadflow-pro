{
  "name": "FormField",
  "type": "object",
  "properties": {
    "form_template_id": {
      "type": "string",
      "description": "ID do template de formul\u00e1rio"
    },
    "field_type": {
      "type": "string",
      "enum": [
        "text",
        "email",
        "phone",
        "number",
        "select",
        "checkbox",
        "textarea",
        "date",
        "cpf",
        "cnpj"
      ],
      "default": "text",
      "description": "Tipo do campo"
    },
    "label": {
      "type": "string",
      "description": "R\u00f3tulo do campo"
    },
    "placeholder": {
      "type": "string",
      "description": "Texto placeholder"
    },
    "is_required": {
      "type": "boolean",
      "default": false,
      "description": "Se o campo \u00e9 obrigat\u00f3rio"
    },
    "options": {
      "type": "string",
      "description": "Op\u00e7\u00f5es para campos select, separadas por v\u00edrgula"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o do campo"
    },
    "is_default": {
      "type": "boolean",
      "default": false,
      "description": "Se \u00e9 um campo padr\u00e3o do sistema"
    }
  },
  "required": [
    "form_template_id",
    "field_type",
    "label"
  ]
}