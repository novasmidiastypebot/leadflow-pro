{
  "name": "TeamMember",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "ID do cliente ao qual o membro pertence"
    },
    "name": {
      "type": "string",
      "description": "Nome completo do membro"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "E-mail do membro"
    },
    "phone": {
      "type": "string",
      "description": "Telefone de contato"
    },
    "password": {
      "type": "string",
      "description": "Senha de acesso"
    },
    "role": {
      "type": "string",
      "enum": [
        "master",
        "manager",
        "supervisor",
        "producer"
      ],
      "default": "producer",
      "description": "Fun\u00e7\u00e3o do membro"
    },
    "parent_member_id": {
      "type": "string",
      "description": "ID do superior hier\u00e1rquico"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "description": "Status do membro"
    }
  },
  "required": [
    "client_id",
    "name",
    "email",
    "password",
    "role"
  ]
}