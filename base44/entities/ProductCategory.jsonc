      "type": "string",
      "description": "ID do cliente"
    },
    "name": {
      "type": "string",
      "description": "Nome da categoria"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da categoria"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
